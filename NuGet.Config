<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- WinRT requires the official Windows SDK targeting pack; application code adds no third-party packages. -->
  <packageSources><clear /><add key="nuget.org" value="https://api.nuget.org/v3/index.json" /></packageSources>
  <packageSourceMapping><packageSource key="nuget.org"><package pattern="Microsoft.Windows.SDK.NET.Ref" /></packageSource></packageSourceMapping>
</configuration>
