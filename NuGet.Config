<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- WinRT requires the official Windows SDK targeting pack; application code adds no third-party packages. -->
  <packageSources><clear /><add key="nuget.org" value="https://api.nuget.org/v3/index.json" /></packageSources>
  <packageSourceMapping><packageSource key="nuget.org">
    <package pattern="Microsoft.Windows.SDK.NET.Ref" />
    <package pattern="Microsoft.NET.ILLink.Tasks" />
    <package pattern="Microsoft.NETCore.App.Runtime.win-x64" />
    <package pattern="Microsoft.WindowsDesktop.App.Runtime.win-x64" />
    <package pattern="Microsoft.AspNetCore.App.Runtime.win-x64" />
  </packageSource></packageSourceMapping>
</configuration>
