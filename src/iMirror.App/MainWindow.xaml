<Window x:Class="iMirror.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:v="clr-namespace:iMirror.App.Views"
        Title="iMirror" Icon="Assets/Branding/iMirror.ico" Width="960" Height="620" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Presentation.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Background><StaticResource ResourceKey="CanvasBrush"/></Window.Background>
  <Window.Foreground><StaticResource ResourceKey="TextBrush"/></Window.Foreground>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="Header" Padding="24,14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Visibility="{Binding IsFullscreen, Converter={StaticResource ChromeVisibility}}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/Branding/iMirror.png" Width="32" Height="32" Margin="0,0,10,0"/><TextBlock Text="iMirror" FontSize="24" FontWeight="SemiBold"/><Border Background="{StaticResource RaisedBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="DESKTOP" Style="{StaticResource Caption}" FontSize="9"/></Border></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding PhoneHeadline}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="Diagnóstico" Style="{StaticResource GhostButton}" Command="{Binding DiagnosticsCommand}" ToolTip="Logs e detalhes da conexão"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Width="194" Padding="12,22,12,16" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Visibility="{Binding IsFullscreen, Converter={StaticResource ChromeVisibility}}">
        <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="12,0"><TextBlock Text="SEU IPHONE. SEU PC." Style="{StaticResource Caption}" FontSize="10"/><TextBlock Text="AirPlay + Bluetooth" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
          <StackPanel>
            <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="0" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelection}, ConverterParameter=0, Mode=OneWay}" Checked="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" Margin="0,2,12,0"/><TextBlock Text="Espelhamento"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="1" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelection}, ConverterParameter=1, Mode=OneWay}" Checked="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE962;" Margin="0,2,12,0"/><TextBlock Text="Controle"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="2" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelection}, ConverterParameter=2, Mode=OneWay}" Checked="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE765;" Margin="0,2,12,0"/><TextBlock Text="Teclado"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="3" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelection}, ConverterParameter=3, Mode=OneWay}" Checked="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" Margin="0,2,12,0"/><TextBlock Text="Gravação"/></StackPanel></RadioButton>
            <RadioButton Style="{StaticResource NavigationItem}" GroupName="Navigation" Tag="4" IsChecked="{Binding SelectedPage, Converter={StaticResource PageSelection}, ConverterParameter=4, Mode=OneWay}" Checked="OnNavigate"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,2,12,0"/><TextBlock Text="Configurações"/></StackPanel></RadioButton>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <v:MirrorView x:Name="MirrorPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=0}"/>
        <v:ControlView x:Name="ControlPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=1}"/>
        <v:KeyboardView x:Name="KeyboardPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=2}"/>
        <v:RecordingView Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=3}"/>
        <v:SettingsView x:Name="SettingsPage" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=4}"/>
      </Grid>
      <Border Grid.ColumnSpan="2" Background="#C0101218" Visibility="{Binding DiagnosticsOpen, Converter={StaticResource BoolVisibility}}">
        <v:DiagnosticsView x:Name="DiagnosticsPanel" Margin="24" MaxWidth="1100" Height="430" VerticalAlignment="Center"/>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,9" Visibility="{Binding IsFullscreen, Converter={StaticResource ChromeVisibility}}"><TextBlock Text="{Binding Notice}" ToolTip="{Binding Notice}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}"/></Border>
  </Grid>
</Window>
