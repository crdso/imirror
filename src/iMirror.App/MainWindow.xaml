<Window x:Class="iMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iMirror" Width="1050" Height="900" MinWidth="800" MinHeight="800"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="180" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="iMirror" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ConnectionStatus}" ToolTip="{Binding ConnectionStatus}" TextTrimming="CharacterEllipsis" Foreground="#555B66" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="AirPlayButton" Content="{Binding AirPlayButtonText}" Command="{Binding AirPlayCommand}"
                Padding="18,9" Margin="0,0,8,0" ToolTip="Iniciar ou parar o receiver AirPlay" />
        <Button x:Name="FullscreenButton" Content="{Binding FullscreenButtonText}"
                Command="{Binding FullscreenCommand}" Padding="18,9" ToolTip="F11: fullscreen; ESC: sair" />
      </StackPanel>
    </Grid>
    <Border x:Name="VideoPlaceholder" Grid.Row="1" Background="#16191F" BorderBrush="#333844"
            BorderThickness="1" CornerRadius="4" MinHeight="160">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <TextBlock Text="Tela do iPhone" Foreground="#ECEFF4" FontSize="23" TextAlignment="Center" />
        <TextBlock Text="Nesta etapa, o vídeo abre em uma janela externa." Foreground="#A6ADBA" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="No iPhone: Central de Controle → Espelhamento de Tela → iMirror - Windows" Foreground="#A6ADBA" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" MaxHeight="250" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
    <StackPanel>
      <TextBlock Text="{Binding AirPlay.StateText, StringFormat='AirPlay: {0}'}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Bluetooth.StateText, StringFormat='Bluetooth: {0}'}" Margin="0,4,0,0" />
      <WrapPanel Margin="0,6,0,4">
        <Button x:Name="BluetoothButton" Content="{Binding BluetoothButtonText}" Command="{Binding BluetoothCommand}" Padding="10,6" Margin="0,0,8,4" />
        <Button x:Name="ControlButton" Content="{Binding ControlButtonText}" Command="{Binding ControlCommand}" IsEnabled="{Binding CanControl}" Padding="10,6" Margin="0,0,8,4" />
        <CheckBox Content="Capturar teclado" IsChecked="{Binding CaptureKeyboard}" IsEnabled="{Binding Bluetooth.KeyboardConnected}" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Text="{Binding HidStatus}" FontSize="12" />
      <TextBlock Text="{Binding ControlStatus}" FontSize="12" Margin="0,3,0,0" />
      <TextBlock Text="No iPhone: Ajustes > Bluetooth > este PC. Para o cursor: Ajustes > Acessibilidade > Toque > AssistiveTouch = ON." TextWrapping="Wrap" FontSize="12" Foreground="#555B66" Margin="0,4,0,0" />
      <TextBlock Text="Quer continuar usando o teclado do próprio iPhone? Ative 'Mostrar Teclado na Tela' no AssistiveTouch (recomendado)." TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
      <WrapPanel Margin="0,5,0,0">
        <TextBlock Text="Velocidade do cursor:" VerticalAlignment="Center" />
        <Slider x:Name="CursorSpeedSlider" Minimum="0.25" Maximum="3" TickFrequency="0.05" Value="{Binding CursorSpeed}" Width="145" Margin="6,0" ToolTip="Multiplicador linear; padrão 1x. Reative o controle depois de ajustar." />
        <TextBlock Text="{Binding CursorSpeed, StringFormat='{}{0:F2}x'}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Text="Layout:" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="KeyboardLayoutSelector" ItemsSource="{Binding KeyboardLayouts}" SelectedItem="{Binding KeyboardLayoutMode}" Width="215" />
      </WrapPanel>
      <TextBlock Text="Para melhor correspondência, configure no iPhone: Ajustes > Geral > Teclado > Teclado Físico com o mesmo layout selecionado aqui." FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
      <Expander Header="Host, diagnóstico HID e opções" Margin="0,4,0,0">
        <StackPanel>
          <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" DisplayMemberPath="DisplayName" MinWidth="200" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding HostDiagnostics}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,4" />
          <TextBlock Text="Não é necessário ativar Adaptações de Toque, Controle de Permanência ou Teclas do Mouse. Deixe Controle de Permanência e Teclas do Mouse OFF." FontSize="12" TextWrapping="Wrap" Margin="0,3,0,5" />
          <WrapPanel>
            <TextBlock Text="Wheel:" VerticalAlignment="Center" />
            <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WheelIntensity}" Width="100" Margin="5,0,8,0" />
            <TextBlock Text="Anúncio:" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox SelectedIndex="{Binding AppearanceIndex}" IsEnabled="{Binding CanChangeAppearance}" Width="200">
              <ComboBoxItem Content="HOGP normal (padrão)" />
              <ComboBoxItem Content="Appearance Keyboard 0x03C1" />
              <ComboBoxItem Content="Appearance Mouse 0x03C2" />
            </ComboBox>
          </WrapPanel>
          <Button Content="Controle direto experimental — indisponível" IsEnabled="False" HorizontalAlignment="Left" Margin="0,5,0,0" ToolTip="Ponteiro absoluto/digitizer não foi validado fisicamente no iOS; o perfil atual é relativo." />
        </StackPanel>
      </Expander>
      <TextBlock Text="{Binding VideoMetrics}" Foreground="#555B66" Margin="0,6,0,0" />
      <TextBlock Text="{Binding TimingMetrics}" Foreground="#555B66" Margin="0,4,0,0" />
      <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#555B66" Margin="0,8,0,0" />
    </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Logs" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" Background="White"
               BorderBrush="#CDD2DB" FontFamily="Consolas" FontSize="12"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding DisplayText}" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="2" Text="{Binding LogFilePath}" ToolTip="{Binding LogFilePath}"
                 FontSize="11" Foreground="#626976" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
    </Grid>
  </Grid>
</Window>
