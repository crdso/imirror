<UserControl x:Class="iMirror.App.Views.ControlView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Themes/Presentation.xaml"/></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageSpacing}" MaxWidth="850" HorizontalAlignment="Stretch">
    <TextBlock Text="Controle" Style="{StaticResource PageTitle}"/><TextBlock Text="Mouse e teclado por Bluetooth. Sem jailbreak." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Conexão Bluetooth" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="{Binding BluetoothSummary}" FontSize="16"/>
        <TextBlock Text="{Binding HidSchemaProfile}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <WrapPanel Margin="0,12,0,16"><Button x:Name="BluetoothButton" Content="{Binding BluetoothButtonText}" Command="{Binding PairingCommand}" IsEnabled="{Binding CanTogglePairing}"/>
          <Button Content="Problemas para parear?" Command="{Binding PairingHelpCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/></WrapPanel>
        <TextBlock Text="{Binding PairingGuidance}" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
        <Expander Header="Etapas do pareamento" IsExpanded="{Binding PairingVisible}"><TextBlock Text="{Binding PairingSteps}" LineHeight="23" Style="{StaticResource Caption}" Margin="0,8,0,0"/></Expander>
        <TextBlock Text="{Binding HidStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding ProviderDiagnostics}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        <TextBlock Text="Vínculos Bluetooth do Windows · diagnóstico separado do HID" FontWeight="SemiBold" Margin="0,16,0,8"/>
        <TextBlock Text="{Binding WindowsBluetoothStatus}" Style="{StaticResource Caption}"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Controle do mouse" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding ControlSummary}" Style="{StaticResource Caption}"/></StackPanel><Button x:Name="ControlButton" Grid.Column="1" Content="{Binding ControlButtonText}" Command="{Binding ControlCommand}" IsEnabled="{Binding CanControl}" Style="{StaticResource PrimaryButton}" ToolTip="Requer vídeo ativo e mouse/teclado Bluetooth conectados."/></Grid><TextBlock Text="Velocidade"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Slider x:Name="CursorSpeedSlider" Minimum="0.25" Maximum="3" TickFrequency="0.05" Value="{Binding CursorSpeed}" Margin="0,14,20,14" ToolTip="Ajuste entre 0,25x e 3x; reative o controle após mudar."/><TextBlock Grid.Column="1" Text="{Binding CursorSpeed, StringFormat='{}{0:F2}x'}" VerticalAlignment="Center" FontSize="18"/></Grid><TextBlock Text="0,25x                                                                 3x" Style="{StaticResource Caption}"/><TextBlock Text="Durante o controle, use o ponteiro do iPhone. Esc libera o mouse para clicar normalmente no PC." Style="{StaticResource Caption}" Margin="0,20,0,0"/><TextBlock Text="{Binding ControlStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Rolagem" Style="{StaticResource CardTitle}"/><TextBlock Text="Intensidade do scroll" Style="{StaticResource Caption}"/><Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding WheelIntensity}" MaxWidth="360" HorizontalAlignment="Left" Width="320"/><TextBlock Text="Quer usar o teclado do iPhone? Ative Mostrar Teclado na Tela no AssistiveTouch." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
