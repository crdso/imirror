<UserControl x:Class="iMirror.App.Views.DiagnosticsView" KeyboardNavigation.TabNavigation="Cycle" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Themes/Presentation.xaml"/></UserControl.Resources>
  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><Button Content="Fechar" Command="{Binding CloseDiagnosticsCommand}" Style="{StaticResource GhostButton}" DockPanel.Dock="Right"/><TextBlock Text="Diagnóstico" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Copiar" Command="{Binding CopyLogsCommand}" Margin="8,0,0,0"/><Button Content="Limpar" Command="{Binding ClearLogsCommand}" ToolTip="Limpa apenas a lista da interface; arquivos preservados." Margin="8,0,0,0"/><Button Content="Abrir pasta" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0"/></StackPanel><ComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}"/></DockPanel>
    <ListBox x:Name="LogList" Grid.Row="2" ItemsSource="{Binding LogView}" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock Grid.Row="3" Text="{Binding LogFilePath}" ToolTip="{Binding LogFilePath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,12,0,0"/>
  </Grid></Border>
</UserControl>
