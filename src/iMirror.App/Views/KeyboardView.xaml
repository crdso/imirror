<UserControl x:Class="iMirror.App.Views.KeyboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Themes/Presentation.xaml"/></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageSpacing}" MaxWidth="850">
    <TextBlock Text="Teclado" Style="{StaticResource PageTitle}"/><TextBlock Text="Digite no iPhone com o teclado do PC." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Layout e captura" Style="{StaticResource CardTitle}"/><CheckBox Content="Capturar teclado na janela de vídeo" IsChecked="{Binding CaptureKeyboard}" IsEnabled="{Binding Bluetooth.KeyboardConnected}"/><TextBlock Text="Layout do teclado" Margin="0,12,0,10"/><ComboBox x:Name="KeyboardLayoutSelector" ItemsSource="{Binding KeyboardLayouts}" SelectedItem="{Binding KeyboardLayoutMode}" MaxWidth="400" HorizontalAlignment="Left" Width="350"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource KeyboardLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Use o mesmo layout no Windows e no teclado físico do iPhone." Style="{StaticResource Caption}" Margin="0,20,0,0"/><TextBlock Text="No iPhone: Ajustes → Geral → Teclado → Teclado Físico." Style="{StaticResource Caption}" Margin="0,8,0,0"/><TextBlock Text="Após ajustar o layout, reative o controle. Esc ou Ctrl+Alt+Q interrompe a captura." Style="{StaticResource Caption}" Margin="0,20,0,0"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
