<UserControl x:Class="iMirror.App.Views.MirrorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Themes/Presentation.xaml"/></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="{StaticResource PageSpacing}" MinHeight="420"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Espelhamento" Style="{StaticResource PageTitle}"/><TextBlock Text="Seu iPhone, em uma tela maior." Style="{StaticResource Caption}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AirPlayButton" Content="{Binding AirPlayButtonText}" Command="{Binding AirPlayCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="FullscreenButton" Content="{Binding FullscreenButtonText}" Command="{Binding FullscreenCommand}" ToolTip="F11 para tela cheia. Esc para sair."/></StackPanel>
    </Grid>
    <Border x:Name="VideoPlaceholder" Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="18" MinHeight="160">
      <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450">
          <Border Width="82" Height="128" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Margin="0,0,0,24"><Grid><Border Width="26" Height="4" Background="{StaticResource LineBrush}" CornerRadius="2" VerticalAlignment="Top" Margin="0,10,0,0"/><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Width="26" Height="3" Background="{StaticResource LineBrush}" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,0,9"/></Grid></Border>
          <TextBlock Text="{Binding MirrorTitle}" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock Text="{Binding MirrorInstruction}" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,12,0,16" LineHeight="23"/>
          <Button Content="Abrir janela de vídeo" Command="{Binding FocusVideoCommand}" IsEnabled="{Binding CanFocusVideo}" Visibility="{Binding CanFocusVideo, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center"/>
          <TextBlock Text="Vídeo em janela externa" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,16,0,0"><TextBlock Text="{Binding AirPlay.StateText, StringFormat='AirPlay  ·  {0}'}" Style="{StaticResource Caption}" Margin="0,0,24,0"/><TextBlock Text="{Binding BluetoothSummary, StringFormat='Bluetooth  ·  {0}'}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ControlSummary, StringFormat='Controle  ·  {0}'}" Style="{StaticResource Caption}" Margin="24,0,0,0"/></WrapPanel>
      </Grid>
    </Border>
  </Grid></ScrollViewer>
</UserControl>
