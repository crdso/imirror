<UserControl x:Class="iMirror.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><ResourceDictionary Source="../Themes/Presentation.xaml"/></UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="{StaticResource PageSpacing}" MaxWidth="850">
    <TextBlock Text="Configurações" Style="{StaticResource PageTitle}"/><TextBlock Text="Conexão e diagnóstico, quando você precisar." Style="{StaticResource Caption}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Diagnóstico" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding VideoMetrics}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TimingMetrics}" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Button Content="Abrir diagnóstico" Command="{Binding DiagnosticsCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dispositivo Bluetooth" Style="{StaticResource CardTitle}"/><ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" DisplayMemberPath="DisplayName"/><TextBlock Text="{Binding HostDiagnostics}" Style="{StaticResource Caption}" Margin="0,12,0,16"/><Expander Header="Opções avançadas do anúncio"><StackPanel Margin="0,16,0,0"><ComboBox SelectedIndex="{Binding AppearanceIndex}" IsEnabled="{Binding CanChangeAppearance}"><ComboBoxItem Content="HOGP normal (padrão)"/><ComboBoxItem Content="Appearance Keyboard 0x03C1"/><ComboBoxItem Content="Appearance Mouse 0x03C2"/></ComboBox><TextBlock Text="Appearance alternativo depende do adaptador e do Windows. O perfil normal permanece como padrão." Style="{StaticResource Caption}" Margin="0,12,0,0"/><TextBlock Text="Ponteiro absoluto não validado; o controle atual usa mouse relativo." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel></Border>
  </StackPanel></ScrollViewer>
</UserControl>
