<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Branding\iMirror.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>iMirror</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF owns startup/DPI. Forms is used only for the native tray icon/menu. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\Branding\*.png;Assets\Branding\*.ico" />
    <Content Include="..\..\tools\send-ctrl-c.ps1" Link="send-ctrl-c.ps1" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ProjectReference Include="..\iMirror.Core\iMirror.Core.csproj" />
    <ProjectReference Include="..\iMirror.AirPlay\iMirror.AirPlay.csproj" />
    <ProjectReference Include="..\iMirror.Bluetooth\iMirror.Bluetooth.csproj" />
    <ProjectReference Include="..\iMirror.Input\iMirror.Input.csproj" />
  </ItemGroup>
</Project>
